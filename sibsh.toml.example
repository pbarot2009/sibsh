# sibsh configuration file (example)
#
# How to use this file:
#   mkdir -p ~/.sibsh
#   cp sibsh.toml.example ~/.sibsh/sibsh.toml
#
# Location: ~/.sibsh/sibsh.toml (override with the SIBSH_CONFIG env var)
# A copy of this template is also written automatically on first run.
#
# Syntax: TOML subset - strings "like this", integers, booleans,
# arrays of strings ["a", "b"], [sections], and # comments.
#
# Every key below is optional. Delete what you do not need;
# a missing or invalid file never stops the shell from starting.

# ------------------------------------------------------------------
# prompt: custom prompt text. Setting this REPLACES the built-in
#   two-line segment prompt with your own single-line template.
#   Available placeholders:
#   {user}   your username          {host}  machine hostname
#   {cwd}    current directory      {status} last exit code (0 on success)
#   {branch} git branch name, empty outside a repository
# Default (when this line is removed): the two-line segment prompt
#
#   ╭─ [sibsh] ~/code/project on  main [⇡2 ⇣1 !3 ?1] via  rs [3.42s ]
#   ╰─❯
#
#   Segments appear only when relevant: user@host only over SSH,
#   git only inside a repository, timer only after commands slower
#   than 2s, exit badge only on failure, and root mode (UID 0) shows
#   `#` and drops the rest.
#
# Examples:
#   prompt = "sibsh {cwd} $ "
#   prompt = "[{status}] {user}:{cwd} > "
# ------------------------------------------------------------------
#prompt = "{user}@{host}:{cwd} ❯ "

# ------------------------------------------------------------------
# icons: glyph set for the built-in prompt.
#   "ascii" uses plain fallbacks: +- frame, > pointer, git: prefix,
#           ^ / v for ahead/behind, rs / go / c language tags.
#   Remove the line (or any other value) for Nerd Font symbols:
#           ╭─ ╰─ frames, ❯ ❭ pointers,  branch icon, ⇡ ⇣ sync flags.
# ------------------------------------------------------------------
#icons = "ascii"

# ------------------------------------------------------------------
# git_status: set false to hide the `on  branch [flags]` segment.
# This also skips the git subprocess that runs at every prompt, which
# helps in very large repositories or non-git directories.
# ------------------------------------------------------------------
#git_status = true

# ------------------------------------------------------------------
# history_limit: maximum number of commands kept in memory this session.
# Oldest entries are dropped first. Remove the line for unlimited.
# ------------------------------------------------------------------
history_limit = 1000

# ------------------------------------------------------------------
# imports: shell files executed once at startup, before the first prompt,
# bashrc/zshrc style. Each line of each file runs through sibsh:
#
#   WORKS:  export KEY=VALUE      (set environment variables)
#           alias name='value'    (define aliases)
#           plain commands        (echo hello, cd /tmp, ...)
#           # comments            (and blank lines are skipped)
#
#   SKIPPED SILENTLY: bash-only syntax sibsh cannot parse, such as
#           if/then/fi, case/esac, for loops, functions, [[ ]] tests,
#           command substitution $(...), source, ulimit, stty ...
#
# This means you can point imports at your real ~/.bashrc or ~/.zshrc
# and sibsh picks up the exports and aliases it understands. Lines it
# cannot run are skipped without errors, so sharing one rc file between
# bash/zsh/sibsh is safe.
#
# Paths support a leading ~/ for your home directory.
# ------------------------------------------------------------------
#imports = ["~/.bashrc", "~/.zshrc"]

# ------------------------------------------------------------------
# aliases: startup shortcuts. Same effect as typing
#   alias ll='ls -la'
# at the prompt. Runtime `alias`/`unalias` work too but are not saved
# back to this file. The first word of a command expands once.
#
# Add or remove lines freely; values may contain multiple words.
# ------------------------------------------------------------------
[aliases]
ll = "ls -la"
la = "ls -a"
gs = "git status"
